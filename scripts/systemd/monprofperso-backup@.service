[Unit]
Description=Sauvegarde PostgreSQL et objets Mon Prof Perso (%i)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=mpp-ops
Group=mpp-ops
SupplementaryGroups=docker
WorkingDirectory=/srv/monprofperso/control
ExecStart=/usr/bin/node /srv/monprofperso/control/scripts/operations.mjs backup --config /etc/monprofperso/backup-%i.env --environment %i
UMask=0077
TimeoutStartSec=3h
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/monprofperso/state /var/lib/monprofperso

[Install]
WantedBy=multi-user.target
