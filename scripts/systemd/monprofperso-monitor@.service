[Unit]
Description=Sondes et alerte Mon Prof Perso (%i)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=mpp-ops
Group=mpp-ops
WorkingDirectory=/srv/monprofperso/control
ExecStart=/usr/bin/node /srv/monprofperso/control/scripts/operations.mjs monitor --config /etc/monprofperso/monitor-%i.env --environment %i
UMask=0077
TimeoutStartSec=90s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/monprofperso/state /var/lib/monprofperso

[Install]
WantedBy=multi-user.target
