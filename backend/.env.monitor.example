# Copier dans /etc/monprofperso/monitor-prod.env, droits 0600.
MPP_ENVIRONMENT=prod
MPP_STATE_DIR=/srv/monprofperso/state/prod
MONITOR_WEB_URL=https://www.monprofperso.com
MONITOR_API_URL=https://api.monprofperso.com
# Optionnel : SHA40 attendu. Vide = disponibilité/readiness sans SHA fixé.
MONITOR_EXPECTED_SHA=
BACKUP_STATE_FILE=/srv/monprofperso/state/prod/backup-state.json
BACKUP_MAX_AGE_HOURS=26
RESTIC_REPOSITORY=s3:https://s3.example.invalid/monprofperso-backups/prod
RESTIC_PASSWORD_FILE=/etc/monprofperso/restic-prod.password
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
RESTIC_CACHE_DIR=/var/lib/monprofperso/restic-cache

# Aucun message externe sans ces deux réglages explicitement renseignés.
# Le webhook reçoit seulement {"text":"Mon Prof Perso prod : incident — ready"}.
MONITOR_ALERTS_ENABLED=false
ALERT_WEBHOOK_URL=
MONITOR_ALERT_REPEAT_MINUTES=240
