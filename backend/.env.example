# Mon Prof Perso, variables d'environnement du backend.
# Copier ce fichier en `.env` (non versionné) et y mettre les vraies valeurs.
#   cp .env.example .env

# --- PostgreSQL ---
POSTGRES_USER=monprofperso
POSTGRES_PASSWORD=change-me            # ⚠️ en prod : secret fort, jamais commité
POSTGRES_DB=monprofperso

# --- Authentification ---
JWT_SECRET=local-only-replace-with-a-random-secret-before-exposure
# Démo strictement locale : aucun OTP réel, connexion explicite aux comptes de test.
# Désactivée par défaut ; les déploiements staging/production la forcent à false.
DEMO_MODE=false
# Pour essayer hors ligne, passer DEMO_MODE et PAYSTACK_MOCK à true ensemble.

# --- OTP réel (bootstrap avant la première connexion admin) ---
OTP_ENABLED=false
OTP_WHATSAPP_ENABLED=false
OTP_WHATSAPP_BASE_URL=
OTP_WHATSAPP_SESSION_ID=
OTP_WHATSAPP_API_KEY=
# TRUST_PROXY doit contenir uniquement les adresses/CIDR des reverse proxies fiables.
TRUST_PROXY=

# --- Cloudflare (optionnel, DNS, admin R2, Workers via API) ---
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# --- Stockage objet (Cloudflare R2 ou MinIO local) ---
# Prod / cloud : R2 (console Cloudflare → R2 → Manage R2 API Tokens)
# S3_ENDPOINT=<account_id>.r2.cloudflarestorage.com
# S3_PORT=443
# S3_USE_SSL=true
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=monprofperso
#
# Dev hors-ligne : MinIO Docker (docker compose --profile local-minio up -d)
# Console http://localhost:9003 · API S3 hôte http://localhost:9002 (conteneur minio:9000)
S3_ENDPOINT=
# Avec --profile local-minio uniquement : S3_ENDPOINT=minio
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=monprofperso
S3_SECRET_KEY=change-me-too
S3_BUCKET=monprofperso
#
# Prod / cloud : R2 (commenter MinIO ci-dessus)
# S3_ENDPOINT=<account_id>.r2.cloudflarestorage.com
# S3_PORT=443
# S3_USE_SSL=true
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=monprofperso

# --- Paiements Paystack (Mobile Money CI) ---
# Sandbox : https://dashboard.paystack.com — clés test sk_test_… / pk_test_…
# Webhook : https://api.monprofperso.com/api/payments/paystack/webhook
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Tests locaux sans appel Paystack (charge mock immédiate ou OTP si PAYSTACK_MOCK_OTP=true)
PAYSTACK_MOCK=false
# PAYSTACK_MOCK_OTP=true

# --- Ports hôte (mapping docker) ---
API_PORT=8099
PG_HOST_PORT=5544
ADMINER_PORT=8098
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003
WEB_PORT=8095
