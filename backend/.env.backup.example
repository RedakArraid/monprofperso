# Copier dans /etc/monprofperso/backup-prod.env, droits 0600.
# Ce fichier est lu comme dotenv littéral, jamais exécuté par un shell.
# Séparer entièrement production et staging : base, bucket, dépôt et mot de passe.
MPP_ENVIRONMENT=prod
MPP_REPOSITORY=/srv/monprofperso/control
MPP_ENV_FILE=/etc/monprofperso/production.env
MPP_RELEASES_DIR=/srv/monprofperso/releases
MPP_STATE_DIR=/srv/monprofperso/state/prod
MPP_WEB_URL=https://www.monprofperso.com
MPP_GITHUB_REPO=RedakArraid/monprofperso
# MPP_RELEASE_DIR est déduit du journal current.json après préparation.

# Dépôt créé explicitement avec `restic init` avant le premier backup.
# L'exemple est volontairement inexploitable : choisir un prestataire distinct
# du disque/VPS primaire. HTTPS et vérification TLS restent actifs.
RESTIC_REPOSITORY=s3:https://s3.example.invalid/monprofperso-backups/prod
RESTIC_PASSWORD_FILE=/etc/monprofperso/restic-prod.password
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
RESTIC_CACHE_DIR=/var/lib/monprofperso/restic-cache
BACKUP_TEMP_DIR=/var/lib/monprofperso/backup-tmp
BACKUP_STATE_FILE=/srv/monprofperso/state/prod/backup-state.json
BACKUP_MAX_AGE_HOURS=26

# Aucun `forget`/`prune` automatique : définir et approuver la rétention d'abord.
# Binaire en option si absent du PATH : RESTIC_BIN=/usr/local/bin/restic
# CLI GitHub authentifiée en lecture pour les préparations et activations.
# Ne pas placer de secrets sur la ligne de commande.
