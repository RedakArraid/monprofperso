# Mon Prof Perso, production (VPS). Copier vers .env.production sur le serveur.
# Ne jamais committer .env.production.

# --- Domaines Traefik ---
MP2_WEB_HOST=monprofperso.com
MP2_API_HOST=api.monprofperso.com

# --- PostgreSQL ---
POSTGRES_USER=monprofperso
POSTGRES_PASSWORD=GENERER_UN_SECRET_FORT
POSTGRES_DB=monprofperso

# --- Authentification ---
JWT_SECRET=GENERER_32_OCTETS_ALEATOIRES
NODE_ENV=production
APP_ENV=production
DEMO_MODE=false
# Téléphone réellement contrôlé pour remplacer l’admin du seed au premier démarrage.
ADMIN_BOOTSTRAP_PHONE=
PAYSTACK_MOCK=false
# Les valeurs OTP_* surchargent les réglages administrateur en base.
# Configurer WhatsApp avant le déploiement pour pouvoir se connecter comme admin.
OTP_ENABLED=true
OTP_WHATSAPP_ENABLED=true
OTP_DEFAULT_CHANNEL=whatsapp
OTP_WHATSAPP_BASE_URL=
OTP_WHATSAPP_SESSION_ID=
OTP_WHATSAPP_API_KEY=
OTP_CODE_TTL_MINUTES=10
# Laisser vide jusqu'à connaître les adresses/CIDR exacts des proxies de confiance.
TRUST_PROXY=

# --- Paystack : clés test en staging, clés live en production ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# --- Cloudflare R2 (stockage fichiers) ---
S3_ENDPOINT=
S3_PORT=443
S3_USE_SSL=true
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=monprofperso

# --- Mise en service (fermée tant que les contrôles ne sont pas validés) ---
SERVICE_OPEN=false
# Révision Git complète, injectée automatiquement par le script de déploiement.
RELEASE_SHA=
# Numéros E.164 des comptes de recette autorisés avant ouverture (séparés par virgules).
# La connexion exige toujours un OTP ; les paiements restent ceux de l’environnement.
LAUNCH_TEST_PHONES=
ONLINE_COURSES_ENABLED=false
WORKER_ENABLED=true
NOTIFICATIONS_ENABLED=false
PUBLIC_WEB_URL=https://www.monprofperso.com
CORS_ALLOWED_ORIGINS=https://www.monprofperso.com,https://monprofperso.com
